#!/bin/bash
clang_format=$(make --no-print-directory print-clang-format) || exit 1
status=0
while IFS= read -r -d '' file; do
    git show ":$file" | $clang_format --assume-filename="$file" --dry-run --Werror || status=1
done < <(git diff --cached --name-only -z --diff-filter=ACM -- 'src/*.c' 'src/*.h' 'tests/*.c' 'tests/*.h')
exit $status
